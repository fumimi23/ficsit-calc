---
// UI は React アイランド(PlannerApp)に閉じ、計算コアはフレームワーク非依存のまま保つ(issue #3)
// ページの紙面(方眼紙 + 図面枠)とヘッダーはここで持つ(issue #24)
import { PlannerApp } from "../components/PlannerApp";
import "../styles/tokens.css";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>ficsit-calc</title>
  </head>
  <body>
    <div class="sheet">
      <header>
        <h1>ficsit-calc</h1>
        <p>Satisfactory 生産チェーン計算機 — 目標アイテムとレートから生産チェーンを逆算します。</p>
      </header>
      <PlannerApp client:load />
    </div>
  </body>
</html>

<style>
  .sheet {
    max-width: 72rem;
    margin: 2rem auto 4rem;
    border: 2px solid var(--frame);
    outline: 1px solid var(--frame);
    outline-offset: 3px;
    background: var(--sheet-bg);
    padding: 1.75rem 2.25rem 3rem;
  }

  header {
    border-bottom: 2px solid var(--frame);
    padding-bottom: 0.9rem;
  }

  h1 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  header p {
    margin: 0.2rem 0 0;
    color: var(--ink-2);
    font-size: 0.88rem;
  }

  @media (max-width: 48rem) {
    .sheet {
      margin: 0.75rem;
      padding: 1rem 1.1rem 2rem;
    }
  }
</style>
